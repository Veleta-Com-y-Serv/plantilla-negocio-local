---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño cálido de la plantilla: foto grande redondeada con la tarjeta de título que la solapa (como la portada),
// tarjeta blanca con el `detalle` y, al lado, la tabla de datos y la caja de encargo; galería de fotos redondeadas y
// otros servicios de la misma lista en tarjetas. Sin foto, el icono va en un bloque de color.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = seccion('contacto') ? enlace('/#contacto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Escríbenos';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="ficha-hero">
        {f.imagen ? (
          <Imagen src={f.imagen} alt={f.titulo} ancho={1600} alto={1000} prioridad class="ficha-foto" />
        ) : (
          <div class="ficha-foto ficha-foto--icono" aria-hidden="true"><Icono nombre={f.icono || 'hoja'} tam={96} /></div>
        )}
        <div class="tarjeta ficha-titulo">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1>{f.titulo}</h1>
          {f.texto && <p class="ficha-resumen">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={contacto}>{textoContacto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ficha-bloque">
    <div class="contenedor ficha-cuerpo">
      <article class="tarjeta ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="tarjeta ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja">
          <p class="ficha-caja-titulo">¿Te lo guardamos?</p>
          <p>Escríbenos o llámanos y te lo preparamos para cuando pases.</p>
          <a class="btn-sec" href={contacto}>{textoContacto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="ficha-fotos" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="ficha-otras">
          {otras.map((o, i) => (
            <li class="tarjeta ficha-otra">
              <span class:list={['ficha-otra-icono', i % 2 ? 'bg-acento' : 'bg-primario']}><Icono nombre={o.icono || 'hoja'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todo lo que hacemos</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: .5rem 2rem; }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 700; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: var(--c-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { position: relative; margin-top: .5rem; }
  .ficha-hero :global(.ficha-foto), .ficha-foto { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 2rem; }
  .ficha-foto--icono { display: grid; place-items: center; background: color-mix(in srgb, var(--c-acento) 30%, var(--c-fondo)); color: var(--c-primario); }
  .ficha-titulo { position: relative; margin: -4rem .75rem 0; padding: 1.5rem; }
  .ficha-titulo h1 { margin-top: .75rem; font-size: clamp(2rem, 6vw, 3.2rem); color: var(--c-primario); overflow-wrap: anywhere; }
  .ficha-resumen { margin-top: 1rem; font-size: 1.1rem; opacity: .85; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.25rem; color: var(--c-primario); margin-top: 1rem; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .ficha-bloque { padding-top: 1rem; }
  .ficha-cuerpo { display: grid; gap: 2rem; }
  .ficha-detalle { padding: 1.5rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.2rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.3rem; margin-bottom: .75rem; }
  .ficha-datos { padding: 1.5rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-top: 2px dotted color-mix(in srgb, var(--c-texto) 18%, transparent); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-datos .ficha-precio { margin-top: 0; font-size: 1.1rem; }
  .ficha-caja { display: grid; gap: .9rem; border-radius: 1.5rem; padding: 1.75rem 1.5rem; background: var(--c-primario); color: #fff; }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; font-weight: 800; line-height: 1.15; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: #fff; text-decoration: none; }
  .ficha-fotos { padding-block: 2.5rem 1rem; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: 1.5rem; overflow: hidden; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; }
  .ficha-otra-icono { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; color: #fff; }
  .ficha-otra h3 { font-size: 1.25rem; margin-top: .35rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; border-radius: 1.5rem; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: 2px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-pie .ficha-precio { margin-top: 0; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--c-primario); }
  @media (min-width: 768px) {
    .ficha-hero :global(.ficha-foto), .ficha-foto { aspect-ratio: 16 / 8; }
    .ficha-titulo { position: absolute; bottom: 2rem; left: 2rem; margin: 0; max-width: 32rem; padding: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
    .ficha-detalle { padding: 2.5rem; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
