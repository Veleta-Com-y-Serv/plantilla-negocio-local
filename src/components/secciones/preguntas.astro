---
// Preguntas frecuentes: acordeón nativo <details> en tarjetas redondas, sin JavaScript.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta.
// También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} contenedor="max-w-3xl">
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <div class="grid gap-4">
        {preguntas.map((p, i) => (
          <details class="faq tarjeta px-6" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 py-5 text-lg font-bold">
              {p.pregunta}
              <span class="faq-signo grid h-9 w-9 shrink-0 place-items-center rounded-full bg-acento/40 text-xl text-primario" aria-hidden="true">+</span>
            </summary>
            {p.respuesta && <p class="pb-6 text-lg opacity-80">{p.respuesta}</p>}
          </details>
        ))}
      </div>
    </Seccion>
  )
}

<style>
  .faq summary { list-style: none; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-signo { transition: transform 0.2s ease; }
  .faq[open] .faq-signo { transform: rotate(45deg); }
</style>
