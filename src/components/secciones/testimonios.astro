---
// Opiniones: tarjetas con estrellas que se deslizan en horizontal en el móvil (dentro de su caja, sin mover la página).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} class="bg-acento/25">
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul data-desliza class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
        {s.testimonios.map((t) => (
          <li class="tarjeta w-[85%] shrink-0 snap-center p-6 md:w-auto">
            <p class="flex gap-0.5 text-acento" role="img" aria-label="5 de 5 estrellas">
              {[1, 2, 3, 4, 5].map(() => <Icono nombre="estrella" tam={18} class="fill-current" />)}
            </p>
            <blockquote class="mt-3 text-lg">{t.texto}</blockquote>
            <p class="mt-4 font-bold text-primario">{t.autor}</p>
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
