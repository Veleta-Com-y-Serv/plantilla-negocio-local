---
// Servicios / carta: tarjetas redondas con imagen y un icono en círculo de color.
import { seccion } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import { enlaceDe } from '../../lib/paginas';
// Los servicios con `detalle` tienen página propia (/servicios/<slug>/): la tarjeta entera enlaza a ella.
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {s.items.map((it, i) => (
          <li class="tarjeta overflow-hidden">
            {it.imagen && <Imagen src={it.imagen} alt={altFicha(it)} ancho={800} alto={600} class="aspect-[4/3] w-full object-cover" />}
            <div class="relative p-6 pt-10">
              <span class:list={['absolute -top-7 left-6 grid h-14 w-14 place-items-center rounded-full text-white ring-4 ring-white', i % 2 ? 'bg-acento' : 'bg-primario']}>
                <Icono nombre={it.icono} tam={26} />
              </span>
              <h3 class="text-xl">{enlaceDe(it) ? <a href={enlaceDe(it)} class="servicio-enlace">{it.titulo}</a> : it.titulo}</h3>
              {it.texto && <p class="mt-2 opacity-80">{it.texto}</p>}
              {enlaceDe(it) && <span class="mt-3 inline-flex items-center gap-1 font-bold text-primario" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
            </div>
          </li>
        ))}
      </ul>
    </Seccion>
  )
}

<style>
  .servicio-enlace { text-decoration: none; color: inherit; }
  /* La tarjeta tiene overflow hidden: el enlace «estirado» se sale del bloque de texto y se recorta al borde de la tarjeta. */
  .servicio-enlace::after { content: ""; position: absolute; inset: -30rem; }
  .servicio-enlace:focus-visible { outline: none; }
  li:has(.servicio-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: 2px; }
</style>
